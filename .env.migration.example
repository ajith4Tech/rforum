# Copy to .env.migration (gitignored) on the new host. Do not commit real values.
# docker compose --env-file .env.migration -f docker-compose.migration.yml up -d

# ── Postgres (container) ──────────────────────────────────────────────
POSTGRES_USER=rforum
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=rforum

# ── App secrets (app/config.py required fields) ───────────────────────
SECRET_KEY=change-me-to-a-random-secret-in-production
INVITE_CODE=change-me-invite-code

# JSON array. Include the origin you will use for the IP smoke test
# (http://NEW_HOST_IP) and the public hostname after DNS cutover.
CORS_ORIGINS=["http://127.0.0.1"]

# Optional — leave empty to skip SUPER_ADMIN auto-promotion (app/config.py).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_BOOTSTRAP_TOKEN=
ORG_DISPLAY_NAME=

# ── S3 (same bucket / IAM user as the current host). Empty S3_ENDPOINT = AWS.
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_REGION=eu-north-1
S3_ENDPOINT=
S3_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MAX_RETRIES=3

# Database Configuration
# PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://rforum:rforum@db:5432/rforum

# Redis Configuration
# Redis URL for real-time pub/sub and caching
REDIS_URL=redis://redis:6379/0

# JWT Configuration
# Secret key for signing JWT tokens (generate a strong random string for production)
SECRET_KEY=change-me-to-a-random-secret-in-production

# JWT Algorithm (HS256 is recommended)
ALGORITHM=HS256

# Session token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration
# List of allowed origins for CORS requests (JSON array format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]

# Authentication Configuration
# Invite code required for user registration
INVITE_CODE=RFORUM01

# Super Admin Configuration
# Email of user to be promoted to super admin on first registration (optional)
# Leave empty to disable auto-promotion
SUPER_ADMIN_EMAIL=

# File Upload Configuration
# Maximum file upload size in MB
UPLOAD_MAX_MB=20

# Allowed file extensions for uploads (comma-separated if using .env)
# Supported: .pdf, .ppt, .pptx, .doc, .docx, .txt, .odp, .odt
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.ppt,.pptx,.doc,.docx,.txt,.odp,.odt

# Presentation Storage Backend
# "local" (default, filesystem under STORAGE_ROOT) or "s3".
# When "s3", reads/exists fall back to the local filesystem for presentations
# uploaded before the switchover — see app/storage/fallback.py. New writes
# always go to S3. Run scripts/migrate_presentations_to_s3.py to backfill.
STORAGE_PROVIDER=local
STORAGE_ROOT=uploads

# S3 backend config (only used when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=eu-north-1
# Optional endpoint override, e.g. for MinIO/R2. Leave empty for AWS.
S3_ENDPOINT=
# Bucket-level namespace root (analogous to STORAGE_ROOT for local disk).
# Leave empty — every key the app builds already starts with "presentations/"
# (app/storage/keys.py), so setting this to "presentations" too would double
# it up into s3://bucket/presentations/presentations/... Only set this if you
# want an *additional* namespace segment above that, e.g. per-environment
# ("staging", "prod").
S3_PREFIX=
# Leave empty to use boto3's default credential chain (IAM role, shared
# credentials file, etc.) instead of static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_MAX_RETRIES=3
# Reserved for future use — the backend still proxies bytes through the API
# rather than issuing presigned URLs.
USE_PRESIGNED_URLS=false

# Rate Limiting (all per-client-IP, fixed-window — see app/rate_limit.py)
# Defaults are sized for a live workshop where many participants share one
# venue/NAT IP. Raise further if a single audience IP exceeds ~a few hundred
# concurrent people (e.g. one corporate NAT for the whole venue).
JOIN_RATE_LIMIT=300
JOIN_RATE_LIMIT_WINDOW_SECONDS=60
WS_CONNECT_RATE_LIMIT=300
WS_CONNECT_RATE_WINDOW_SECONDS=60
# Per-guest-identifier cap (individual abuse) and per-IP cap (many guests
# behind one shared IP is expected, not abuse) on response submissions.
RESPONSE_RATE_LIMIT_PER_GUEST=10
RESPONSE_RATE_LIMIT_PER_GUEST_WINDOW_SECONDS=60
RESPONSE_RATE_LIMIT_PER_IP=400
RESPONSE_RATE_LIMIT_PER_IP_WINDOW_SECONDS=60

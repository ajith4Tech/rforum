# ─────────────────────────────────────────────────────────────────────────────
# Rforum — deployment environment template
# Copy to .env and fill in all required values before starting the application.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ────────────────────────────────────────────────────────────

# PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://rforum:rforum@db:5432/rforum

# Redis URL for real-time pub/sub
REDIS_URL=redis://redis:6379/0

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED. Generate a strong random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Startup will fail if this is left at the default value.
SECRET_KEY=change-me-to-a-random-secret-in-production

# JWT algorithm (HS256 recommended)
ALGORITHM=HS256

# Session token expiration in minutes (default: 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed origins. Must include the domain your frontend runs on.
# Example for production: CORS_ORIGINS=["https://yourdomain.com"]
# Example for local dev:  CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# ── File uploads ──────────────────────────────────────────────────────────────
# Maximum file upload size in MB
UPLOAD_MAX_MB=20

# Allowed file extensions for uploads (comma-separated)
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.ppt,.pptx,.doc,.docx,.txt,.odp,.odt

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: Invite code, org name, org logo, and admin account are now managed
# through the database (system_settings table), not environment variables.
#
# First-time setup:
#   1. Start the app — the system_settings row is seeded automatically.
#   2. Navigate to /login — you will see "Create Admin Account".
#   3. Register the first account; it becomes SUPER_ADMIN automatically.
#   4. Log in to the dashboard and manage settings via the admin panel.
# ─────────────────────────────────────────────────────────────────────────────
